  "rules": [
    {
      "id": "revenue_keywords",
      "category": "BUSINESS_REVENUE",
      "direction": "CREDIT",
      "weight": 0.6,
      "patterns": [
        "\\b(?:INV|INVOICE|BILL NO|SALES?|SALE PROCEEDS|PAYMENT RECEIVED|PYMT RECD|PMT RECD|COLLECTION|CUSTOMER|ORDER)\\b"
      ],
      "exclude": [
        "\\bCASHBACK\\b",
        "\\bREFUND\\w*",
        "\\bRETURN(?:ED)?\\b",
        "\\bREV(?:ERSAL|ERSED|L)?\\b",
        "\\bRFND\\b",
        "\\bRTN\\b"
      ]
    },
    {
      "id": "revenue_settlement",
      "category": "BUSINESS_REVENUE",
      "direction": "CREDIT",
      "weight": 0.6,
      "patterns": [
        "\\b(?:RAZORPAY|PAYU|CCAVENUE|CASHFREE|PAYTM SETTL\\w*|PG SETTL\\w*|POS SETTL\\w*|MERCHANT SETTL\\w*|SWIGGY PAYOUT|ZOMATO PAYOUT|AMAZON SELLER|FLIPKART SELLER)\\b"
      ],
      "exclude": [
        "\\bLOAN\\b",
        "\\bREFUND\\b"
      ],
      "keyword_is_counterparty": true
    },
    {
      "id": "other_income",
      "category": "OTHER_BUSINESS_INCOME",
      "direction": "CREDIT",
      "weight": 0.65,
      "patterns": [
        "\\b(?:COMMISSION RECEIVED|INCENTIVE|SUBSIDY|GRANT|DIVIDEND|RENT RECEIVED|SCRAP SALE|INSURANCE CLAIM|CLAIM SETTL\\w*|DUTY DRAWBACK)\\b"
      ],
      "exclude": [
        "\\bCASHBACK\\b",
        "\\bREFUND\\w*",
        "\\bRETURN(?:ED)?\\b",
        "\\bREV(?:ERSAL|ERSED|L)?\\b",
        "\\bRFND\\b",
        "\\bRTN\\b"
      ]
    },
    {
      "id": "interest_income",
      "category": "INTEREST_INCOME",
      "direction": "CREDIT",
      "weight": 0.85,
      "patterns": [
        "\\bINT(?:EREST)?\\.? ?(?:PD|PAID|CR|CREDIT|CREDITED)\\b",
        "\\bINTEREST ON (?:SB|FD|DEPOSIT|SWEEP)\\b",
        "\\b(?:SB|FD|RD) INT(?:EREST)?\\b",
        "\\bCREDIT INTEREST\\b"
      ]
    },
    {
      "id": "supplier_keywords",
      "category": "SUPPLIER_PAYMENT",
      "direction": "DEBIT",
      "weight": 0.6,
      "patterns": [
        "\\b(?:PURCHASE|SUPPLIER|VENDOR|MATERIAL|RAW MAT\\w*|INV|INVOICE|BILL NO|PO NO|ADVANCE TO)\\b"
      ],
      "exclude": [
        "\\bCASHBACK\\b",
        "\\bREFUND\\w*",
        "\\bRETURN(?:ED)?\\b",
        "\\bREV(?:ERSAL|ERSED|L)?\\b",
        "\\bRFND\\b",
        "\\bRTN\\b"
      ]
    },
    {
      "id": "salary",
      "category": "SALARY",
      "direction": "DEBIT",
      "weight": 0.85,
      "patterns": [
        "\\b(?:SALARY|SALARIES|SAL|WAGES?|PAYROLL|STIPEND|BONUS)\\b"
      ]
    },
    {
      "id": "rent",
      "category": "RENT",
      "direction": "DEBIT",
      "weight": 0.85,
      "patterns": [
        "\\b(?:RENT|RENTAL|LEASE RENT|LICENSE FEE|LEAVE AND LICENSE)\\b"
      ],
      "exclude": [
        "\\bRENT RECEIVED\\b",
        "\\bRENTAL INCOME\\b"
      ]
    },
    {
      "id": "utilities",
      "category": "UTILITIES",
      "direction": "DEBIT",
      "weight": 0.85,
      "patterns": [
        "\\b(?:ELECTRICITY BILL|EB BILL|POWER BILL|WATER (?:BILL|TAX|CHARGES)|GAS BILL|PIPED GAS|BROADBAND|TELEPHONE|MOBILE BILL|POSTPAID|INTERNET BILL|ELECTRICITY)\\b"
      ]
    },
    {
      "id": "utility_providers",
      "category": "UTILITIES",
      "direction": "DEBIT",
      "weight": 0.85,
      "keyword_is_counterparty": true,
      "patterns": [
        "\\b(?:ELECTRICITY BOARD|ELEC BOARD|WATER BOARD|TNEB|TANGEDCO|BESCOM|MSEDCL|BSES|CESC|TATA POWER|ADANI ELEC\\w*|TORRENT POWER|AIRTEL|JIO|VODAFONE|VI POSTPAID|BSNL|MAHANAGAR GAS|INDRAPRASTHA GAS)\\b"
      ]
    },
    {
      "id": "tax",
      "category": "TAX_PAYMENT",
      "direction": "DEBIT",
      "weight": 0.85,
      "patterns": [
        "\\b(?:GST (?:PMT|PAYMENT|CHALLAN|TAX)|GSTN|CPIN|CBDT|INCOME TAX|ADVANCE TAX|SELF ASSESSMENT TAX|TDS|TAX PAYMENT|ITNS ?\\d*|PROFESSIONAL TAX|PROPERTY TAX|ESIC|EPFO?|PROVIDENT FUND|CUSTOMS DUTY)\\b"
      ]
    },
    {
      "id": "bank_charges",
      "category": "BANK_CHARGES",
      "direction": "DEBIT",
      "weight": 0.85,
      "max_amount": 50000,
      "patterns": [
        "\\b(?:CHARGES?|CHRGS?|CHGS?|COMMISSION|COMM|SMS (?:ALERT|CHG\\w*)|MIN(?:IMUM)? BAL\\w*|NON MAINT\\w*|PENAL(?:TY)?|SERVICE (?:CHARGE|FEE)|PROCESSING FEE|FEE|GST ON CHG\\w*|DEBIT CARD (?:FEE|AMC|ANNUAL)|AMC|FOLIO CHG|CHQ BOOK|STAMP DUTY|IMPS CHG|NEFT CHG|RTGS CHG|ECS RTN CHG)\\b"
      ],
      "exclude": [
        "\\bCOMMISSION RECEIVED\\b",
        "\\bSCHOOL FEE"
      ]
    },
    {
      "id": "insurance",
      "category": "INSURANCE",
      "direction": "DEBIT",
      "weight": 0.8,
      "patterns": [
        "\\b(?:INSURANCE|PREMIUM|POLICY NO|POLICY|LIFE INS\\w*|GEN(?:ERAL)? INS\\w*)\\b"
      ]
    },
    {
      "id": "insurers",
      "category": "INSURANCE",
      "direction": "DEBIT",
      "weight": 0.8,
      "keyword_is_counterparty": true,
      "patterns": [
        "\\b(?:LIC|HDFC ERGO|ICICI LOMBARD|BAJAJ ALLIANZ|NEW INDIA ASSURANCE|STAR HEALTH|TATA AIG|SBI LIFE|HDFC LIFE|ICICI PRU\\w*|MAX LIFE|UNITED INDIA INS\\w*|ORIENTAL INS\\w*)\\b"
      ]
    },
    {
      "id": "operating",
      "category": "OPERATING_EXPENSE",
      "direction": "DEBIT",
      "weight": 0.7,
      "patterns": [
        "\\b(?:FREIGHT|TRANSPORT\\w*|LOGISTICS|COURIER|REPAIRS?|MAINTENANCE|FUEL|DIESEL|PETROL|STATIONERY|PRINTING|ADVERTIS\\w*|MARKETING|PROFESSIONAL FEES?|AUDIT FEES?|CONSULTANCY|LEGAL FEES?|SOFTWARE|SUBSCRIPTION|TRAVEL|HIRE CHARGES|LABOUR|JOB WORK)\\b"
      ]
    },
    {
      "id": "loan_disbursement",
      "category": "LOAN_DISBURSEMENT",
      "direction": "CREDIT",
      "weight": 0.9,
      "patterns": [
        "\\bLOAN ?DISB\\w*",
        "\\bDISBURSE?(?:MENT|D)?\\b",
        "\\bDISB\\b",
        "\\bTERM LOAN (?:CR|CREDIT)\\b",
        "\\bLOAN (?:A C |AC |ACCOUNT )?(?:CR|CREDIT)\\b",
        "\\b(?:OD|CC) LIMIT\\b",
        "\\bBUSINESS LOAN\\b"
      ],
      "exclude": [
        "\\bEMI\\b",
        "\\bREPAY\\w*"
      ]
    },
    {
      "id": "emi",
      "category": "LOAN_REPAYMENT",
      "direction": "DEBIT",
      "weight": 0.85,
      "patterns": [
        "\\bEMI\\b",
        "\\bLOAN (?:REPAY\\w*|INST\\w*|RECOVERY)\\b",
        "\\bINSTAL+MENT\\b",
        "\\bLN ?(?:REPAY\\w*|INST\\w*)\\b",
        "\\bTL (?:REPAY\\w*|INST\\w*)\\b",
        "\\bNACH\\b.*\\b(?:FIN\\w*|LOAN|CAPITAL|CREDIT)\\b",
        "\\bACH DR\\b.*\\b(?:LOAN|FIN\\w*)\\b"
      ]
    },
    {
      "id": "interest_payment",
      "category": "INTEREST_PAYMENT",
      "direction": "DEBIT",
      "weight": 0.85,
      "patterns": [
        "\\b(?:OD|CC|LOAN|TL) INT(?:EREST)?\\b",
        "\\bINT(?:EREST)? (?:ON )?(?:OD|CC|LOAN|DEBIT|DR|CHARGED|APPLIED)\\b",
        "\\bINTEREST DEBIT\\b",
        "\\bDR INT\\b"
      ]
    },
    {
      "id": "own_account",
      "category": "OWN_ACCOUNT_TRANSFER",
      "direction": "ANY",
      "weight": 0.85,
      "patterns": [
        "\\bOWN (?:A C|AC|ACCOUNT|ACCT)\\b",
        "\\bSELF (?:TRF|TRANSFER|A C|AC)\\b",
        "\\b(?:TO|FROM) SELF\\b",
        "\\b(?:AUTO )?SWEEP\\b",
        "\\b(?:FD|FIXED DEPOSIT|RD) (?:BOOKING|CREATION|CLOSURE|PREMAT\\w*|MATURITY|A C|AC)\\b",
        "\\bTRF (?:TO|FROM) (?:FD|RD)\\b"
      ]
    },
    {
      "id": "internal_transfer_words",
      "category": "INTERNAL_TRANSFER",
      "direction": "ANY",
      "weight": 0.35,
      "patterns": [
        "\\b(?:IFT|INTRA ?BANK|FUNDS? TRANSFER|INTERNAL TRANSFER|A C TRANSFER|TRANSFER (?:TO|FROM) A C)\\b"
      ]
    },
    {
      "id": "cash_deposit",
      "category": "CASH_DEPOSIT",
      "direction": "CREDIT",
      "weight": 0.9,
      "patterns": [
        "\\b(?:CASH ?DEP\\w*|CSH ?DEP|BY CASH|CDM|CASH CR|CASH DEPOSIT)\\b"
      ]
    },
    {
      "id": "cash_withdrawal",
      "category": "CASH_WITHDRAWAL",
      "direction": "DEBIT",
      "weight": 0.9,
      "patterns": [
        "\\b(?:ATM|ATW|CASH ?W(?:D|DL|ITHDRAWAL)|CSH ?WDL|NFS CASH|SELF CHQ|CHQ PAID SELF|CASH PAID)\\b"
      ]
    },
    {
      "id": "investment",
      "category": "INVESTMENT",
      "direction": "ANY",
      "weight": 0.8,
      "patterns": [
        "\\b(?:MUTUAL FUND|MF (?:PURCHASE|SIP|REDEMPTION)|SIP|DEMAT|SHARES? PURCHASE|NPS)\\b"
      ]
    },
    {
      "id": "investment_platforms",
      "category": "INVESTMENT",
      "direction": "ANY",
      "weight": 0.8,
      "keyword_is_counterparty": true,
      "patterns": [
        "\\b(?:ZERODHA|GROWW|NSDL|CDSL|BSE STAR|UPSTOX|KFINTECH|CAMS)\\b"
      ]
    },
    {
      "id": "refund",
      "category": "REFUND",
      "direction": "CREDIT",
      "weight": 0.85,
      "patterns": [
        "\\bREFUND\\w*\\b",
        "\\bRFND\\b",
        "\\bCASHBACK\\b"
      ]
    },
    {
      "id": "reversal",
      "category": "REVERSAL",
      "direction": "ANY",
      "weight": 0.75,
      "patterns": [
        "\\bREV(?:ERSAL|ERSED|L)?\\b",
        "\\bRETURN(?:ED)?\\b",
        "\\bRTN\\b",
        "\\bRET\\b",
        "\\bBOUNCE[D]?\\b",
        "\\bFAILED\\b",
        "\\bUNPAID\\b",
        "\\bDISHONOU?R\\w*",
        "\\bCANCEL+(?:ED|ATION)?\\b"
      ],
      "exclude": [
        "\\bGST ?R? ?\\d? RETURN\\b",
        "\\bITR\\b",
        "\\bTAX RETURN\\b"
      ]
    }
  ],
