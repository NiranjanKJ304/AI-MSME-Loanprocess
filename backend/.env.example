# ---------------------------------------------------------------------------
# AI-MSME Loan Decision Intelligence Platform (prototype) - backend settings
# Copy to backend/.env and adjust.
# ---------------------------------------------------------------------------

# Locally installed PostgreSQL (e.g. PostgreSQL 18 Windows service on port 5432).
# Create the database once:  psql -U postgres -c "CREATE DATABASE msme_loans"
# Check the connection:     python -m scripts.check_db
DATABASE_URL=postgresql+psycopg://postgres:<your_password>@localhost:5432/msme_loans

# Local document storage. Originals are write-once; raw extraction JSON is stored beside them.
STORAGE_DIR=../storage

# Comma-separated list of allowed browser origins for the Next.js frontend
CORS_ORIGINS=http://localhost:3000

# --- File validation ---
MAX_FILE_SIZE_MB=25
MAX_PDF_PAGES=300
MIN_IMAGE_DIMENSION_PX=300

# --- Confidence thresholds ---
# Below this, a document classification is sent to NEEDS_REVIEW.
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.60
# Below this, an extracted field is flagged as low-confidence (NEEDS_REVIEW).
FIELD_CONFIDENCE_THRESHOLD=0.70

# --- Bank statement validation ---
# Absolute tolerance (INR) for previous_balance + credit - debit ~= balance
BALANCE_TOLERANCE=1.00

# --- Cross-document reconciliation ---
# Minimum similarity (0-1) for two business names to be considered consistent
NAME_MATCH_THRESHOLD=0.85
# Optional JSON file overriding per-check variance thresholds (see README)
RECONCILIATION_THRESHOLDS_FILE=

# --- Document requirement policy ---
# Optional JSON file replacing the default PROTOTYPE policy (see README)
REQUIREMENTS_POLICY_FILE=
# Optional JSON file replacing the default financial-health indicator thresholds
HEALTH_THRESHOLDS_FILE=
# Optional JSON file replacing the default forecasting settings (history, backtest, intervals)
FORECAST_CONFIG_FILE=
# Optional JSON file replacing the default repayment-capacity settings (history, stress %, thresholds)
REPAYMENT_CONFIG_FILE=

# --- OCR ---
# none | tesseract   (paddleocr adapter is a stub for later)
OCR_ENGINE=none
# Optional explicit path to the tesseract binary (Windows: C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=
OCR_LANGUAGES=eng
OCR_DPI=300

# --- LLM (optional; used only as a fallback for classification / field extraction) ---
# none | anthropic
LLM_PROVIDER=none
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
# Max characters of document text sent to the LLM (tables are never sent)
LLM_MAX_INPUT_CHARS=12000
